{
    "name": "salesforce-api-svc",
    "version": "0.0.1",
    "description": "Service to interact with Salesforce API",
    "main": "server",
    "private": true,
    "scripts": {
        "build": "tsc --pretty",
        "start:local": "node pulldevsecrets.js && export NODE_OPTIONS='--trace-deprecation --abort-on-uncaught-exception' && export NODE_ENV=development && nodemon --config .nodemonrc.json",
        "start": "export NODE_OPTIONS='--trace-deprecation --abort-on-uncaught-exception' && node ./dist/src/server.js",
        "lint": "eslint",
        "test": "jest --passWithNoTests"
    },
    "devDependencies": {
        "@types/cors": "2.8.17"
    },
    "dependencies": {
        "axios": "1.8.4",
        "cors": "2.8.5",
        "express": "4.21.2",
        "jsforce": "3.2.2",
        "pino-http": "10.2.0",
        "short-unique-id": "5.2.0",
        "tslib": "2.6.3"
    }
}
